# 백엔드 환경 변수 예시. 실제 값은 .env 또는 application-local.yml (커밋 금지)
# DB (MySQL 8.0, utf8mb4 / utf8mb4_0900_ai_ci)
DB_URL=jdbc:mysql://localhost:3306/vet_crm?characterEncoding=UTF-8&serverTimezone=Asia/Seoul
DB_USERNAME=crm
DB_PASSWORD=

# 시드 계정 비밀번호 (POL-ACC-009, NFR-SEC-001). 비우면 그 계정은 만들지 않는다
SEED_ADMIN_PASSWORD=
SEED_DESK_PASSWORD=
SEED_GROOMER_PASSWORD=

# 배포(Railway)에서만 true. 세션 쿠키에 Secure를 붙인다
COOKIE_SECURE=false
